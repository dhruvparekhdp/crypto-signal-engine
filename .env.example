# ==============================================================================
# CRYPTO SIGNAL ENGINE - MINIMAL CONFIGURATION (.env)
# Copy this content into `/home/ubuntu/crypto-signal-engine/.env` on your EC2 instance.
# All strategy, indicator, paper trading, and AI model settings are managed
# dynamically via the Admin Web Dashboard (/settings).
# ==============================================================================

# ── Core Server ───────────────────────────────────────────────────────────────
PORT=8080
PYTHONUNBUFFERED=1

# ── Database & Admin Authentication ───────────────────────────────────────────
# PostgreSQL Database URL (Aiven, Neon, Supabase, or AWS RDS):
# Format: postgresql://username:password@hostname:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Password used to unlock /settings and controls on the web dashboard:
ADMIN_PASSWORD=your_admin_password_here

# ── Telegram Notifications ───────────────────────────────────────────────────
# Bot token from @BotFather (e.g. 123456789:ABCdefGhI...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Numeric Telegram Chat ID (get it by sending /start to @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Groq AI Sentinel ──────────────────────────────────────────────────────────
# Free API key from console.groq.com (Model selection is managed via /settings UI)
GROQ_API_KEY=your_groq_api_key_here

# ── Commodity Feeds (Optional) ────────────────────────────────────────────────
# Twelve Data key for Gold (XAU/USD), Silver (XAG/USD), and Crude Oil (WTI/USD)
TWELVEDATA_API_KEY=


# ── Model providers ───────────────────────────────────────────────────────
# Four accounts, three jobs. Chains are "provider:model, provider:model" in
# preference order; an entry whose key is unset is skipped, so you can name a
# provider before you have signed up for it.
#
#   pre_trade   in the signal path, so speed wins  -> Groq, OpenRouter behind
#   post_trade  nothing waits on it, builds the dataset -> best reasoning
#   research    four calls a month over aggregates -> strongest available
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_CHAIN_PRE_TRADE=groq:openai/gpt-oss-20b, openrouter:qwen/qwen3-32b
# LLM_CHAIN_POST_TRADE=anthropic:claude-sonnet-5, gemini:gemini-2.5-flash, groq:openai/gpt-oss-120b
# LLM_CHAIN_RESEARCH=anthropic:claude-opus-5, gemini:gemini-2.5-pro
# LLM_CHAIN_POSITION_REVIEW=gemini:gemini-2.5-flash, groq:openai/gpt-oss-120b, anthropic:claude-sonnet-5

# A model on your own hardware. Empty = not set up, and every chain that
# names ollama simply skips it. Set it to the Tailscale hostname of the
# machine running `ollama serve`, not to localhost — the engine is on EC2
# and the model is at home.
# OLLAMA_BASE_URL=http://dhruv-ai:11434

# Hermes runs on the machine with the model, not on the engine. Set these
# THERE, not here:
#   ENGINE_URL=http://52.62.37.4:8080
#   SENTIMENT_INGEST_TOKEN=<the same value the engine has>
#   OLLAMA_BASE_URL=http://localhost:11434
