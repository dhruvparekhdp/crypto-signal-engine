# ==============================================================================
# CRYPTO SIGNAL ENGINE - ENVIRONMENT CONFIGURATION (.env)
# Copy this content into `/home/ubuntu/crypto-signal-engine/.env` on your EC2 server.
# ==============================================================================

# ── Core Server & Web ─────────────────────────────────────────────────────────
PORT=8080
PYTHONUNBUFFERED=1

# ── Database & Admin Authentication ───────────────────────────────────────────
# PostgreSQL Database URL (Aiven, Neon, Supabase, or AWS RDS):
# format: postgresql://username:password@hostname:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Password used to unlock settings & execute manual trades on the web dashboard:
ADMIN_PASSWORD=your_admin_password_here

# ── Telegram Notifications ───────────────────────────────────────────────────
# Bot token from @BotFather on Telegram (e.g. 123456789:ABCdefGhI...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your numeric Telegram Chat ID (get it by sending /start to @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Groq AI Sentinel & Reviewer ──────────────────────────────────────────────
# AI review on trade setups (Qwen-3.8-27b on Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_SIGNAL_REVIEW_ENABLED=true

# ── Delta Exchange India (Execution / Trading) ────────────────────────────────
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here
DELTA_TRADING_ENABLED=false

# ── Market Data & Binance Streams ────────────────────────────────────────────
# 1-minute real OHLC klines from Binance public mirror (recommended: true)
BINANCE_KLINES_ENABLED=true
BINANCE_KLINES_SECONDS=60
BINANCE_WS_ENABLED=false

# ── Crypto Strategy & Risk Filters ───────────────────────────────────────────
# Minimum signal confidence to alert / trade (0.0 to 1.0)
CRYPTO_MIN_CONFIDENCE=0.60

# Higher Timeframe Trend Filter & Volume Spike confirmations
CRYPTO_HTF_FILTER_ENABLED=true
CRYPTO_VOLUME_SPIKE_ENABLED=true
HIGH_CONVICTION_ONLY=false

# Snapshot cycle (seconds) for training data & alerts
CRYPTO_SNAPSHOT_INTERVAL_SECONDS=120
CRYPTO_SIGNAL_COOLDOWN_MINUTES=15
CRYPTO_ALERT_TELEGRAM=true
CRYPTO_MAX_STAKE_PCT=0.02
CRYPTO_AUTO_EXECUTE=false

# ── Bank & Stake Sizing ───────────────────────────────────────────────────────
BANK_SIZE=10000.0
MIN_CONFIDENCE=0.65
MAX_STAKE_PCT=0.03

# ── Data Providers (Crypto & Commodities) ─────────────────────────────────────
# CoinDCX (preferred crypto ticker - free, no key required)
COINDCX_POLL_INTERVAL_SECONDS=30

# CoinGecko (fallback crypto ticker - free demo key optional)
COINGECKO_API_KEY=
COINGECKO_POLL_INTERVAL_SECONDS=60

# Twelve Data Commodities (Gold: XAU/USD, Silver: XAG/USD, Crude Oil: WTI/USD)
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
TWELVEDATA_SYMBOLS=XAU/USD,XAG/USD,WTI/USD

# CryptoPanic Sentiment (optional, leave empty if not on paid tier)
CRYPTOPANIC_AUTH_TOKEN=
CRYPTOPANIC_POLL_INTERVAL_SECONDS=300

# ── Sports Collection (Dormant by default to save CPU/Memory) ─────────────────
SPORTS_ENABLED=false
ODDS_API_KEY=your_odds_api_key_here
ODDS_POLL_INTERVAL_SECONDS=300
BETS_API_TOKEN=
SPORTRADAR_API_KEY=
API_SPORTS_KEY=
SPORTSDATA_API_KEY=
API_TENNIS_KEY=

# ── Paper Trading Simulator ───────────────────────────────────────────────────
PAPER_TRADING_ENABLED=true
PAPER_STARTING_WALLET=3000.0
PAPER_TARGET_WALLET=20000.0
PAPER_LEVERAGE=10.0
PAPER_STOP_PCT_OF_MARGIN=0.20
PAPER_REWARD_RISK=2.0
PAPER_MIN_CONFIDENCE=0.70
PAPER_MAX_CONCURRENT=3
PAPER_ALERT_TELEGRAM=true
PAPER_TRAILING_ENABLED=true
PAPER_SCALED_SIZING=true
