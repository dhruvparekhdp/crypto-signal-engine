# ==============================================================================
# CRYPTO SIGNAL ENGINE - MINIMAL CONFIGURATION (.env)
# Copy this content into `/home/ubuntu/crypto-signal-engine/.env` on your EC2 instance.
# All strategy, indicator, paper trading, and AI model settings are managed
# dynamically via the Admin Web Dashboard (/settings).
# ==============================================================================

# ── Core Server ───────────────────────────────────────────────────────────────
PORT=8080
PYTHONUNBUFFERED=1

# ── Database & Admin Authentication ───────────────────────────────────────────
# PostgreSQL Database URL (Aiven, Neon, Supabase, or AWS RDS):
# Format: postgresql://username:password@hostname:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Password used to unlock /settings and controls on the web dashboard:
ADMIN_PASSWORD=your_admin_password_here

# ── Telegram Notifications ───────────────────────────────────────────────────
# Bot token from @BotFather (e.g. 123456789:ABCdefGhI...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Numeric Telegram Chat ID (get it by sending /start to @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Groq AI Sentinel ──────────────────────────────────────────────────────────
# Free API key from console.groq.com (Model selection is managed via /settings UI)
GROQ_API_KEY=your_groq_api_key_here

# ── Commodity Feeds (Optional) ────────────────────────────────────────────────
# Twelve Data key for Gold (XAU/USD), Silver (XAG/USD), and Crude Oil (WTI/USD)
TWELVEDATA_API_KEY=

