# --- Kite Connect (Zerodha) ---
# Get these from https://developers.zerodha.com/ (paid app). NEVER commit real values.
KITE_API_KEY=
KITE_API_SECRET=
# Filled by the auth flow; expires daily. Leave blank initially.
KITE_ACCESS_TOKEN=

# --- Local storage ---
DB_PATH=./data/india_engine.sqlite3
LAKE_DIR=./data/lake

# --- Misc ---
TZ=Asia/Kolkata
# paper | live  (must stay "paper" until the go-live gate is passed)
ENGINE_MODE=paper
